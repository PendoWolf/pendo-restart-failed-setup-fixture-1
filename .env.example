# Copy to .env and set per environment.
# Port the Tripwise API listens on. The Tripwise web app's VITE_API_URL points here.
PORT=3001
# Origin of the Tripwise web app, allowed by CORS.
CORS_ORIGIN=http://localhost:5173
# Key for the Anthropic API, which the Tripwise Assistant's replies come from (POST /api/assistant/chat).
ANTHROPIC_API_KEY=
# Pendo Track Events integration key (a server-side secret) for the Tripwise Assistant's trackAgent events.
# Leave empty to turn agent tracking off.
PENDO_TRACK_EVENT_SECRET=
# Pendo data host for Track Events; use https://app.eu.pendo.io for an EU subscription.
PENDO_DATA_HOST=https://app.pendo.io
