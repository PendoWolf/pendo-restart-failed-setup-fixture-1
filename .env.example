# Copy to .env and set per environment.
# Port the Tripwise API listens on. The Tripwise web app's VITE_API_URL points here.
PORT=3001
# Origin of the Tripwise web app, allowed by CORS.
CORS_ORIGIN=http://localhost:5173
# Key for the Anthropic API, which the Tripwise Assistant's replies come from (POST /api/assistant/chat).
ANTHROPIC_API_KEY=
# Pendo integration key for the API's server-side Track Events (src/analytics/pendo.ts). A secret: leave it out of
# version control. No events are sent while it's empty.
PENDO_TRACK_EVENT_SECRET=
# Pendo data host (a host name, without https://) the Track Events are sent to.
PENDO_DATA_HOST=data.pendo-dev.pendo-dev.com
