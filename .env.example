# Copy to .env and set per environment.
# Port the Tripwise API listens on. The Tripwise web app's VITE_API_URL points here.
PORT=3001
# Origin of the Tripwise web app, allowed by CORS.
CORS_ORIGIN=http://localhost:5173
# Key for the Anthropic API, which the Tripwise Assistant's replies come from (POST /api/assistant/chat).
ANTHROPIC_API_KEY=
# Pendo integration key for the Track Events API, used to send the Tripwise Assistant's agent events.
# Leave empty to send none.
PENDO_INTEGRATION_KEY=
# Pendo Track Events endpoint, for a subscription on another data host.
PENDO_TRACK_URL=https://app.pendo.io/data/track
